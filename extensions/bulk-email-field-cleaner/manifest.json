{
  "manifest_version": 3,
  "name": "Bulk Email Field Cleaner (Template)",
  "version": "4.4.0",
  "description": "Configurable template for removing a target email from records and logging results.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["https://app.example.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bulk Email Field Cleaner"
  }
}
